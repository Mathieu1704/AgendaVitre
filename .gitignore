# DONNEES PRIVEES — NE JAMAIS COMMITTER
# Le depot est public : ces fichiers contiennent des donnees
# personnelles (employes, clients, testeurs) et des documents
# d'entreprise. Ils restent en local uniquement.
####################################
Apple/
doc/company/
doc/factures/
doc/*.pdf
testeurs_gplay.csv
Recap Paiement.docx
MEMOIRE_PROJET.md
# Toute la doc interne reste locale (audits, checklists, guides, notes)
*.md
*.xlsx
*.docx
# Scripts backend : outillage local (imports, migrations ponctuelles, exports).
# Contient des donnees clients et des acces DB — ne doit jamais partir sur le depot public.
**/apps/backend/scripts/

# L'importeur de tournées fait partie de l'application, mais sa sortie contient
# des données clients et doit rester strictement locale.
!vitres-pro/apps/backend/scripts/
vitres-pro/apps/backend/scripts/*
!vitres-pro/apps/backend/scripts/import_tours_word.py
vitres-pro/apps/backend/data/tours_initial_seed.json

####################################
# COPIES / ARTEFACTS LOCAUX
####################################
